{
	"$schema": "./node_modules/wrangler/config-schema.json",
	"name": "lexcerta-mcp",
	"main": "src/worker.ts",
	"compatibility_date": "2026-08-01",
	"workers_dev": false,
	"vars": {
		"BUILD_ID": "production",
		"KEY_ENVIRONMENT": "production"
	},
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "lexcerta-production",
			"database_id": "00000000-0000-0000-0000-000000000001",
			"migrations_dir": "migrations"
		}
	],
	"durable_objects": {
		"bindings": [{ "name": "API_KEY_LIMITER", "class_name": "ApiKeyLimiter" }]
	},
	"migrations": [{ "tag": "v1", "new_sqlite_classes": ["ApiKeyLimiter"] }],
	"observability": {
		"enabled": true
	},
	"env": {
		"test": {
			"name": "lexcerta-mcp-test",
			"workers_dev": true,
			"vars": {
				"BUILD_ID": "local",
				"KEY_ENVIRONMENT": "test"
			},
			"d1_databases": [
				{
					"binding": "DB",
					"database_name": "lexcerta-test",
					"database_id": "00000000-0000-0000-0000-000000000002",
					"migrations_dir": "migrations"
				}
			],
			"durable_objects": {
				"bindings": [{ "name": "API_KEY_LIMITER", "class_name": "ApiKeyLimiter" }]
			}
		},
		"local": {
			"name": "lexcerta-mcp-local",
			"workers_dev": true,
			"vars": {
				"BUILD_ID": "local",
				"KEY_ENVIRONMENT": "test"
			},
			"d1_databases": [
				{
					"binding": "DB",
					"database_name": "lexcerta-local",
					"database_id": "00000000-0000-0000-0000-000000000003",
					"migrations_dir": "migrations"
				}
			],
			"durable_objects": {
				"bindings": [{ "name": "API_KEY_LIMITER", "class_name": "ApiKeyLimiter" }]
			}
		}
	}
}
