{
	"$schema": "./node_modules/wrangler/config-schema.json",
	"name": "lexcerta-mcp",
	"main": "src/worker.ts",
	"compatibility_date": "2026-08-01",
	"workers_dev": false,
	"vars": {
		"BUILD_ID": "local",
		"KEY_ENVIRONMENT": "test"
	},
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "lexcerta",
			"database_id": "00000000-0000-0000-0000-000000000000",
			"migrations_dir": "migrations"
		}
	],
	"observability": {
		"enabled": true
	}
}
